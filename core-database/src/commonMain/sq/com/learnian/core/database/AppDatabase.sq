CREATE TABLE SampleTable (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

insertSample:
INSERT OR REPLACE INTO SampleTable(title, createdAt)
VALUES (?, ?);

getAllSamples:
SELECT * FROM SampleTable ORDER BY createdAt DESC;

deleteSample:
DELETE FROM SampleTable WHERE id = ?;
